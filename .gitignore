# Firebase CLI cache
.firebase/

# Firebase emulator logs
*-debug.log

# Local emulator state
.emulator-data/

# Generated by scripts/gen-post-slugs.mjs during the functions build
/functions/src/postSlugs.json

# App-icon PNGs rendered from the tile SVGs by scripts/build-app-icons.mjs
/public/apps/icons/*.png

# Private apps (listed through NEXT_PUBLIC_PRIVATE_APPS): their code and icons stay local
/app/apps/meetings/
/common/apps/meetings/
/public/apps/meetings/
