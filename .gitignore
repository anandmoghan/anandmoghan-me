npm-debug.log*
build.log
yarn-debug.log*
yarn-error.log*

# Local env files
.env*.local
.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# Admin scripts (service account keys + one-off scripts)
/scripts/*
!/scripts/merge-rules.mjs
!/scripts/seed-roles.ts
!/scripts/seed-emulator.ts
!/scripts/gen-post-slugs.mjs
!/scripts/sync-global.mjs
!/scripts/sync-materials.mjs
!/scripts/publish-materials.ts
!/scripts/verify-emulator.mjs
