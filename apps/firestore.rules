rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile; any authenticated user can read others (needed for invite lookups)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Settings subcollection - only owner can read/write
      match /settings/{setting} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Time app: categories, sessions, rollups — owner only
      match /categories/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /sessions/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /rollups/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Groups - members can read, creator can create, any member can update (for adding members)
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Shared config (exchange rates etc.) — readable by all authenticated users.
    // Writes from clients are only used for the initial seed before the Worker cron
    // has run. The Worker cron (service account) bypasses these rules via IAM.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Invites - identified by toUid (not email)
    match /invites/{inviteId} {
      // Sender and recipient can read
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      // Only the sender can create, and they must be the fromUid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      // Only the recipient can update (accept/decline)
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow delete: if false;
    }
  }
}
