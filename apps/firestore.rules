rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is allowed to read another user's data.
    // readableBy is maintained by the app when group members accept invites.
    function canReadUser(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        (
          'readableBy' in get(/databases/$(database)/documents/users/$(uid)).data &&
          request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.readableBy
        )
      );
    }

    // Users — any authenticated user can read (needed for invite lookups).
    // Only owner can write their own doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Settings — owner only
      match /settings/{setting} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Time app — owner only
      match /categories/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /sessions/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /rollups/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Dashboard: manual assets — owner + group members who accepted invite
      match /assets/{doc=**} {
        allow read: if canReadUser(uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Groups — members can read, creator can create, members can update
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Shared config (exchange rates, instrument metadata) — all authenticated users.
    // Service account writes bypass these rules via IAM.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // T212 encrypted credentials — owner reads only (to check if key is configured).
    // Writes come exclusively from the Worker service account (IAM bypass).
    match /t212Creds/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // T212 portfolio snapshots — owner + group members who accepted invite.
    // Written by Worker cron/sync via service account.
    match /t212Snapshots/{uid} {
      allow read: if canReadUser(uid);
      allow write: if false;
    }

    // Invites — sender and recipient can read, sender creates, recipient updates
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow delete: if false;
    }
  }
}
