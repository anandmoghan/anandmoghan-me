rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Settings subcollection - only owner can read/write
      match /settings/{setting} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Groups - members can read, creator can create, any member can update (for adding members)
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Invites
    match /invites/{inviteId} {
      // Anyone can read invites sent to their email or by them
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.token.email == resource.data.toEmail
      );
      // Only the sender can create an invite
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      // Only the recipient can update (accept/decline)
      allow update: if request.auth != null && request.auth.token.email == resource.data.toEmail;
      allow delete: if false;
    }
  }
}
