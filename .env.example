# Firebase Storage (media)
# Bucket that holds public media (public/**); defaults to anandmoghan-me.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=anandmoghan-me.appspot.com

# Server-side media listing and upload scripts use firebase-admin.
# Either run `gcloud auth application-default login` or point to a service account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cloudflare R2 (only for scripts/migrate-r2-to-storage.ts; remove after migration)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=anandmoghan-media

# Google Analytics
# Get your Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here
