{
  "name": "anandmoghan-me",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "predev": "node scripts/build-app-icons.mjs && tsx scripts/build-app-manifests.ts",
    "dev": "next dev",
    "prebuild": "node scripts/build-app-icons.mjs && tsx scripts/build-app-manifests.ts",
    "build": "next build",
    "postbuild": "tsx scripts/externalize-inline-scripts.ts && tsx scripts/stamp-app-sw.ts",
    "start": "next start",
    "lint": "next lint",
    "sync-global": "node scripts/sync-global.mjs",
    "upload-media": "tsx scripts/upload-media.ts",
    "generate-manifest": "tsx scripts/generate-media-manifest.ts",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy --only hosting,functions,firestore,storage",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "migrate-media": "tsx scripts/migrate-r2-to-storage.ts",
    "rules": "node scripts/merge-rules.mjs",
    "rules:check": "node scripts/merge-rules.mjs --check",
    "test:rules": "npm run rules:check && firebase emulators:exec --only firestore,auth,storage --project demo-anandmoghan-me \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:pwa": "node --import tsx --test tests/pwa/*.test.ts",
    "test:security": "node --import tsx --test tests/security/*.test.ts",
    "test:merge": "firebase emulators:exec --only firestore,auth --project demo-anandmoghan-me \"npm --prefix functions test\"",
    "seed-roles": "tsx scripts/seed-roles.ts",
    "emulators": "npm --prefix functions run build && mkdir -p .emulator-data && firebase emulators:start --only auth,firestore,storage,functions --project demo-anandmoghan-me --import .emulator-data --export-on-exit .emulator-data",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8181 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098 tsx scripts/seed-emulator.ts",
    "dev:emulated": "NEXT_PUBLIC_USE_EMULATORS=true next dev -p 3300",
    "sync-materials": "node scripts/sync-materials.mjs",
    "publish-materials": "NODE_OPTIONS=--conditions=react-server tsx scripts/publish-materials.ts",
    "ladder-migrate": "tsx scripts/ladder-migrate.ts"
  },
  "keywords": [],
  "author": "Anand Mohan",
  "license": "MIT",
  "description": "Unified digital platform for Anand Mohan - AI Scientist at Amazon",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.970.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.3",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.8.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.27",
    "next": "^16.1.2",
    "node": "^25.3.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "to-ico": "^1.1.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.2",
    "firebase-tools": "^15.33.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "marked": "^13.0.3",
    "postcss": "^8.5.6",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
