{
  "$schema": "https://developers.cloudflare.com/pages/platform/build-configuration/",
  "version": 1,
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch_paths": [
      "app/**/*",
      "common/**/*",
      "content/**/*",
      "public/**/*",
      "scripts/**/*",
      "*.config.*",
      "package.json"
    ]
  },
  "deployment": {
    "compatibility_date": "2024-01-01",
    "compatibility_flags": [],
    "placement": {
      "mode": "smart"
    }
  },
  "preview": {
    "branch_preview": {
      "enabled": true,
      "patterns": ["preview/*", "staging/*"]
    },
    "pull_request_preview": {
      "enabled": true
    }
  },
  "production": {
    "branch": "main",
    "deployment_trigger": "on_push"
  }
}
