// ── visitors ──────────────────────────────────────────────────────────────
// Visit log and blog comments. Owned by the Visitors agent.

// visits/{autoId}: { uid, isAnonymous, path, referrer, country, sessionId, createdAt }.
// Written only by the api function (POST /api/visit, admin SDK); admins read.

match /visits/{visitId} {
  allow read: if isAdmin();
  allow write: if false;
}

// postStats/{slug}: { views, updatedAt }. Public view counter, shown in the post header. Written
// only by the api function (POST /api/views/:slug, admin SDK); anyone reads, signed out included.

match /postStats/{slug} {
  allow read: if true;
  allow write: if false;
}

// posts/{slug}/comments/{id}: { uid, displayName, body, createdAt, updatedAt, status }.
// Any session, anonymous included, comments as itself; the author's client copies its profile
// nickname (users/{uid}.displayName) into displayName. The author edits the body or deletes;
// admins hide, unhide and delete. The merge function (admin SDK) rewrites uid and displayName
// when a guest signs in to an existing account. Visible comments are public.

function commentSlug(slug) {
  return slug.size() <= 200 && slug.matches('^[a-z0-9][a-z0-9-]*$');
}

function commentBody(d) {
  return d.body is string && d.body.size() >= 1 && d.body.size() <= 2000;
}

match /posts/{slug}/comments/{commentId} {
  allow read: if resource.data.status == 'visible'
    || (isAuth() && resource.data.uid == request.auth.uid)
    || isAdmin();

  allow create: if isAuth()
    && commentSlug(slug)
    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'body', 'createdAt', 'updatedAt', 'status'])
    && request.resource.data.keys().hasAll(['uid', 'displayName', 'body', 'createdAt', 'updatedAt', 'status'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() >= 1
    && request.resource.data.displayName.size() <= 40
    && commentBody(request.resource.data)
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.status == 'visible';

  allow update: if (
      isAuth()
      && resource.data.uid == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt'])
      && commentBody(request.resource.data)
      && request.resource.data.updatedAt == request.time
    ) || (
      isAdmin()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      && request.resource.data.status in ['visible', 'hidden']
    );

  allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
}

// Comment moderation lists every post's comments with one collection-group query. This also
// matches shareDecks/{slug}/comments; admins may read those too.

match /{path=**}/comments/{commentId} {
  allow read: if isAdmin();
}

// users/{uid}/reads/{readId}: { slug, title, lastReadAt, progress, lastHeadingId }.
// Reading history, written only while the visitor has accepted the "remember what you read"
// consent. Owner read and write only, anonymous included. readId is the slug with '/' replaced
// by '__' (a document id cannot hold a slash), so materials:<page>/<chapter> is one flat doc.

function readFields(d) {
  return d.keys().hasOnly(['slug', 'title', 'lastReadAt', 'progress', 'lastHeadingId'])
    && d.keys().hasAll(['slug', 'title', 'lastReadAt', 'progress', 'lastHeadingId']);
}

function readValid(d, readId) {
  return d.slug is string
    && d.slug.size() <= 200
    && d.slug.matches('^[a-z0-9][a-z0-9:/_-]*$')
    && d.slug.replace('/', '__') == readId
    && d.title is string
    && d.title.size() >= 1
    && d.title.size() <= 300
    && (d.progress is int || d.progress is float)
    && d.progress >= 0
    && d.progress <= 1
    && d.lastHeadingId is string
    && d.lastHeadingId.size() <= 200
    && d.lastReadAt == request.time;
}

match /users/{uid}/reads/{readId} {
  allow read, delete: if isOwner(uid);
  allow create, update: if isOwner(uid)
    && readFields(request.resource.data)
    && readValid(request.resource.data, readId);
}
