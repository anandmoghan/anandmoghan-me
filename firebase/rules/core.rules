// ── helpers ────────────────────────────────────────────────────────────────

function isAuth() {
  return request.auth != null;
}

function isOwner(uid) {
  return isAuth() && request.auth.uid == uid;
}

function isRealAuth() {
  return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

// Owner with a Google or email account (not an anonymous session).
function isRealOwner(uid) {
  return isOwner(uid) && isRealAuth();
}

function isVerified() {
  return isAuth() && request.auth.token.get('email_verified', false) == true;
}

// Custom claims are mirrored from roles/{email} by the syncRoleClaims function.
function isAdmin() {
  return isVerified() && request.auth.token.get('admin', false) == true;
}

function hasApp(name) {
  return isVerified() && name in request.auth.token.get('apps', []);
}

// ── users (profile + app-level prefs) ─────────────────────────────────────
// Every visitor, anonymous included, has users/{uid}: isAnonymous, createdAt, consent,
// displayName (the nickname on comments, guest-7f3a until edited), and for real accounts email
// and photoURL. lastSeenAt, firstSeenAt, country and visitCount are written only by the visit
// function (admin SDK), after the visitor accepts cookies.

function serverOnlyUserFields() {
  return ['lastSeenAt', 'firstSeenAt', 'country', 'visitCount'];
}

// 2 to 30 letters, numbers, spaces, - and _, no space at either end (common/firebase/nickname.ts).
function validNickname(name) {
  return name is string && name.matches('^[A-Za-z0-9_-][A-Za-z0-9 _-]{0,28}[A-Za-z0-9_-]$');
}

// liveActivities is a map keyed by activity ("sleep:<id>"); rules cannot loop over entries, so
// only its type and size are checked.
function validDevice(d) {
  return d.keys().hasOnly(['app', 'platform', 'fcmToken', 'apnsEnv', 'liveActivityStartToken',
      'liveActivities', 'timezone', 'updatedAt'])
    && d.keys().hasAll(['app', 'platform', 'fcmToken', 'apnsEnv', 'timezone', 'updatedAt'])
    && d.app in ['nila', 'planner', 'wealth']
    && d.platform == 'ios'
    && d.fcmToken is string && d.fcmToken.size() >= 1 && d.fcmToken.size() <= 4096
    && d.apnsEnv in ['sandbox', 'production']
    && (!('liveActivityStartToken' in d)
      || (d.liveActivityStartToken is string && d.liveActivityStartToken.size() <= 4096))
    && (!('liveActivities' in d) || (d.liveActivities is map && d.liveActivities.size() <= 20))
    && d.timezone is string && d.timezone.size() >= 1 && d.timezone.size() <= 64
    && d.updatedAt is timestamp;
}

match /users/{uid} {
  // The profile holds the email, photo and visit data: the owner (anonymous included) and admins
  // read it, nobody else. Only admins list.
  allow get: if isOwner(uid) || isAdmin();
  allow list: if isAdmin();
  allow create: if isOwner(uid)
    && !request.resource.data.keys().hasAny(serverOnlyUserFields())
    && (!('displayName' in request.resource.data) || validNickname(request.resource.data.displayName));
  allow update: if isOwner(uid)
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields())
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
      || validNickname(request.resource.data.get('displayName', null)));
  allow delete: if isOwner(uid);

  // App-level prefs (theme, etc.) — single doc at prefs/p
  match /prefs/{doc} {
    allow read, write: if isOwner(uid);
  }

  // Devices (iOS apps): { app, platform, fcmToken, apnsEnv, liveActivityStartToken?,
  // liveActivities?, timezone, updatedAt }, one doc per app install. The owner (a real account)
  // writes them; nobody reads them from a client, the Mac reads with the admin SDK.
  match /devices/{installationId} {
    allow create, update: if isRealOwner(uid) && validDevice(request.resource.data);
    allow delete: if isRealOwner(uid);
  }

  // Notifications: { title, body?, app?, link?, createdAt, readAt }. Written only by the server
  // (admin SDK). The owner reads them, marks them read or unread (readAt only) and deletes them.
  match /notifications/{id} {
    allow read, delete: if isRealOwner(uid);
    allow update: if isRealOwner(uid)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
      && (request.resource.data.readAt == null || request.resource.data.readAt is timestamp);
  }
}

// ── roles (admin only) ────────────────────────────────────────────────────
// roles/{emailLowercase}: { admin: bool, apps: string[], ladderTrackers: string[], ladderHome?: string }.
// Seeded with scripts/seed-roles.ts; edited from the admin panel. The id is always lower case, so
// one email has one role doc (functions/src/roles.ts reads and mirrors only lower-case ids).

match /roles/{email} {
  allow read, delete: if isAdmin();
  allow create, update: if isAdmin() && email == email.lower();
}
