rules_version = '2';

// Storage rules for the default bucket of Firebase project anandmoghan-me.
//
// The default bucket of anandmoghan-me holds the site media (public/**, migrated from Cloudflare R2)
// and the family app files (family/**). Everything else is denied. If another app ever needs
// Storage, add its paths here.
//
// public/**                   site media (images, docs): world-readable, never writable from clients
//                             (uploads go through firebase-admin, which bypasses rules)
// family/<person>/media/**    thumbnails and images written by the Mac bridge (admin SDK, bypasses rules)
// family/<person>/uploads/**  photos uploaded from the app by members (create only, no overwrite), e.g. uploads/<date>/<file>
//
// Membership is family/household.members in Firestore (cross-service firestore.get).
service firebase.storage {
  match /b/{bucket}/o {

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in firestore.get(/databases/(default)/documents/family/household).data.members;
    }

    match /public/{allPaths=**} {
      allow read: if true;
    }

    match /family/{person}/{allPaths=**} {
      allow read: if isMember() && person in ['anand', 'kavya', 'nila'];
    }

    match /family/{person}/uploads/{allPaths=**} {
      allow create: if isMember()
        && person in ['anand', 'kavya', 'nila']
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
