    // ── planner ───────────────────────────────────────────────────────────────
    // Personal planner per Firebase uid: planner/{uid} profile, events mirrored from the iPhone by
    // the Mac server (admin SDK, never the client), and private habits with one day doc per tick.
    // "Household" for the shared calendar view = a verified admin or a user with app 'planner'
    // (claims mirrored from roles/{email} by syncRoleClaims).
    // plannerKeys/{sha256 hex} holds the Shortcut keys: the app stores only the hash and shows the
    // key once; the Mac reads the collection with the admin SDK.

    function plannerAccess() {
      return isAdmin() || hasApp('planner');
    }

    function plannerValidProfile(d) {
      return d.keys().hasOnly(['displayName', 'colour', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'colour', 'updatedAt'])
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
        && d.colour in ['a', 'b', 'c', 'd']
        && d.updatedAt == request.time;
    }

    function plannerValidHabit(d) {
      return d.keys().hasOnly(['name', 'perWeek', 'colour', 'archived', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'perWeek', 'archived', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.perWeek is int && d.perWeek >= 1 && d.perWeek <= 7
        && (!('colour' in d) || d.colour is string)
        && d.archived is bool
        && d.updatedAt == request.time;
    }

    function plannerValidTask(d) {
      return d.keys().hasOnly(['title', 'notes', 'due', 'dueHasTime', 'done', 'doneAt', 'shared',
          'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'dueHasTime', 'done', 'shared', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 200
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
        && (!('due' in d) || d.due is timestamp)
        && d.dueHasTime is bool
        && d.done is bool
        && (!('doneAt' in d) || d.doneAt == null || d.doneAt is timestamp)
        && d.shared is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /planner/{uid} {
      allow read: if plannerAccess();
      allow create, update: if isOwner(uid) && plannerAccess() && plannerValidProfile(request.resource.data);
      allow delete: if false;

      // Written only by the Mac (admin SDK).
      match /events/{eventId} {
        allow read: if plannerAccess();
        allow write: if false;
      }

      // Tasks: the owner has full access. Household members with the planner app read the tasks marked
      // shared and may only tick them (done, doneAt, updatedAt).
      match /tasks/{taskId} {
        allow read: if (isOwner(uid) && plannerAccess())
          || (plannerAccess() && resource.data.shared == true);
        allow create, update: if isOwner(uid) && plannerAccess() && plannerValidTask(request.resource.data);
        allow update: if plannerAccess() && !isOwner(uid) && resource.data.shared == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'updatedAt'])
          && request.resource.data.done is bool
          && (request.resource.data.doneAt == null || request.resource.data.doneAt is timestamp)
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(uid) && plannerAccess();
