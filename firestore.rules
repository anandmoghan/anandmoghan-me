      );

      allow delete: if isRealAuth() && request.auth.uid == resource.data.cb;
    }

    // ── invites ───────────────────────────────────────────────────────────────
    // 'fu' = fromUid, 'tu' = toUid, 's' = status (wire field names)

    match /invites/{inviteId} {
      // Sender or recipient can read
      allow read: if isRealAuth() && (
        request.auth.uid == resource.data.fu ||
        request.auth.uid == resource.data.tu
      );
      // Sender can create
      allow create: if isRealAuth() && request.auth.uid == request.resource.data.fu;
      // Recipient can update status only
      allow update: if isRealAuth()
        && request.auth.uid == resource.data.tu
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s']);
    }

    // ── t212 encrypted credentials ────────────────────────────────────────────
    // Owner reads only (just to check "is configured"). Worker service account
    // bypasses rules via IAM to write the encrypted credentials.

    match /t212Creds/{uid} {
      allow read: if isRealOwner(uid);
      allow write: if false;
    }

    // ── t212 rate limit counters (Functions only, Admin SDK bypasses rules) ───

    match /t212RateLimits/{uid} {
      allow read, write: if false;
    }

    // ── t212 snapshots ────────────────────────────────────────────────────────

    match /t212Snapshots/{uid} {
      allow read: if hasApp('wealth') || isAdmin();
      allow write: if isRealOwner(uid);
    }

    // ── t212 projection settings (growth rate, yearly contribution) ───────────
    // Owner writes; anyone with the wealth app reads (so shared family projections work).

    match /t212Settings/{uid} {
      allow read: if hasApp('wealth') || isAdmin();
      allow write: if isRealOwner(uid);
    }

    // ── config (exchange rates etc.) ──────────────────────────────────────────
    // Exchange rates for wealth and expense; written only by the api function (admin SDK).

    match /config/{doc} {
      allow read: if hasApp('wealth') || hasApp('expense') || isAdmin();
      allow write: if false;
    }

    // ── share app comments ───────────────────────────────────────────────────
    // Unlisted presentation decks; guests use their anonymous session with a nickname
    // and can comment on individual bullets. bulletId/nickname/text are
    // denormalized directly onto each comment doc.

    match /shareDecks/{slug} {
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.bulletId is string
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAuth() && resource.data.authorUid == request.auth.uid;
      }
    }

    // ── ladder ────────────────────────────────────────────────────────────────
    // Job trackers under ladder/{tracker} (anand, kavya): jobs, companies, the profile and the
    // request queue.
    // Access: a verified admin, or a verified user with app 'ladder' and the tracker listed in the
    // ladderTrackers claim (both mirrored from roles/{email} by syncRoleClaims).
    // Clients change only the user-editable job fields and the profile, and queue requests. Everything
    // else (new jobs, companies, body_html, PDFs, request progress) is written by
    // scripts/ladder-migrate.ts and the Mac worker (anandmoghan-me-apis/ladder) with the admin SDK, which bypasses rules.
    // Field shapes match anandmoghan-me-apis/ladder/schema.mjs.

    match /ladder/{tracker} {

      function ladderCanAccess() {
        return tracker in ['anand', 'kavya']
          && (isAdmin() || (hasApp('ladder') && tracker in request.auth.token.get('ladderTrackers', [])));
      }

      function ladderIsDate(v) {
        return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Each changed field (k in the changed set ch) must have a valid value in the new doc d; a
      // removed optional field (absent from d) is fine. Unchanged fields are not re-checked, so an
      // odd value the worker wrote does not block the user's edits.
      function ladderOkEnum(d, ch, k, values) {
        return !(k in ch) || !(k in d) || d[k] in values;
      }

      function ladderOkBool(d, ch, k) {
        return !(k in ch) || !(k in d) || d[k] is bool;
      }

      function ladderOkDate(d, ch, k) {
        return !(k in ch) || !(k in d) || ladderIsDate(d[k]);
      }

      function ladderOkList(d, ch, k, max) {
        return !(k in ch) || !(k in d) || (d[k] is list && d[k].size() <= max);
      }

      // The user-editable fields; updated_at is the client's request time.
      function ladderUserFields() {
        return ['status', 'rating', 'viewed', 'notes', 'apply_prep', 'applied_date', 'decision_date',
                'progress_stage', 'refresh_requested', 'updated_at'];
      }

      function ladderValidUpdate(d, ch) {
        return ch.hasOnly(ladderUserFields())
          && (!('status' in ch) || d.status in ['new', 'saved', 'applied', 'interviewing', 'declined', 'archived'])
          && ladderOkEnum(d, ch, 'rating', ['up', 'down'])
          && ladderOkBool(d, ch, 'viewed')
          && ladderOkBool(d, ch, 'refresh_requested')
          && ladderOkDate(d, ch, 'applied_date')
          && ladderOkDate(d, ch, 'decision_date')
          && ladderOkEnum(d, ch, 'progress_stage',
               ['applied', 'online_assessment', 'phone_screen', 'onsite', 'offer', 'declined'])
          && ladderOkList(d, ch, 'notes', 500)
          && ladderOkList(d, ch, 'apply_prep', 100)
          && (!('updated_at' in ch) || d.updated_at == request.time);
      }

      allow read: if ladderCanAccess();
      allow write: if false;

      match /jobs/{slug} {
        allow read: if ladderCanAccess();
        allow update: if ladderCanAccess()
          && ladderValidUpdate(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
        allow create, delete: if false;
